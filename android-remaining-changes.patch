+
+void ThermalUtils::pollTemperatures()
+{
+	constexpr auto kPollInterval = std::chrono::seconds(2);
+	std::unique_lock<std::mutex> lock(poll_mutex);
+
+	while (!poll_shutdown.load()) {
+		if (poll_cv.wait_for(lock, kPollInterval,
+				[this] { return poll_shutdown.load(); }))
+			break;
+
+		lock.unlock();
+		std::vector<Temperature> temperatures;
+		readTemperatures(temperatures);
+		lock.lock();
+	}
