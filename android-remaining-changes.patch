+// Temporary whyred diagnosis: observe policy discovery without changing its
+// ordering, readability decisions, XML contents, or fallback behavior.
+void logWhyredPolicyDiscovery(const std::string& selectedPath) {
+    const int savedErrno = errno;
+    if (base::GetProperty("ro.product.device", "") != "whyred") {
+        errno = savedErrno;
+        return;
+    }
+    ALOGI("WHYRED_POLICY_DIAG uid=%u euid=%u selected='%s'",
+            static_cast<unsigned>(getuid()), static_cast<unsigned>(geteuid()),
+            selectedPath.c_str());
+    for (const char* key : {"ro.boot.product.vendor.sku", "ro.vendor.qti.va_aosp.support",
+            "ro.bluetooth.a2dp_offload.supported", "persist.bluetooth.a2dp_offload.disabled",
+            "persist.bluetooth.bluetooth_audio_hal.disabled", "ro.bluetooth.leaudio_offload.supported",
+            "persist.bluetooth.leaudio_offload.disabled"}) {
+        char value[PROPERTY_VALUE_MAX] = {};
+        const int length = property_get(key, value, "");
+        ALOGI("WHYRED_POLICY_DIAG property %s='%s' length=%d", key, value, length);
+    }
+    auto paths = audio_get_configuration_paths();
+    // This extra path is a diagnostic probe only: 23.2 searched it when the
+    // Qualcomm va_aosp property was enabled; do not restore it in this test.
+    paths.emplace_back("/vendor/etc/audio");
+    for (const auto& directory : paths) {
+        for (const char* name : {"audio_policy_configuration.xml",
+                "audio_policy_configuration_a2dp_offload_disabled.xml",
+                "audio_policy_configuration_le_offload_disabled.xml",
+                "audio_policy_configuration_bluetooth_legacy_hal.xml"}) {
+            const std::string path = directory + "/" + name;
+            const int accessResult = access(path.c_str(), R_OK);
+            const int accessError = accessResult == 0 ? 0 : errno;
+            struct stat info = {};
+            const int statResult = stat(path.c_str(), &info);
+            const int statError = statResult == 0 ? 0 : errno;
+            ALOGI("WHYRED_POLICY_DIAG probe='%s' access=%d errno=%d stat=%d errno=%d mode=%o",
+                    path.c_str(), accessResult, accessError, statResult, statError,
+                    static_cast<unsigned>(info.st_mode));
+        }
+    }
+    errno = savedErrno;
+}
